GROUP_CHAT_IDS=oc_xxx
CARD_CHAT_IDS=oc_xxx
USER_ID=
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx
LARK_USER_ACCESS_TOKEN=xxx

BITABLE_ENABLED=false

# ==================== LLM ====================
BASE_URL=https://api.deepseek.com
API_KEY=sk-xxx
MODEL_NAME=deepseek-chat

# ==================== Storage ====================
STORAGE_PATH=data

# ==================== Embedding ====================
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1/embeddings
EMBEDDING_MODEL_NAME=Qwen3-Embedding-4B
EMBEDDING_API_KEY=

# ==================== Reranker ====================
RERANKER_BASE_URL=http://127.0.0.1:8001
RERANKER_MODEL_NAME=Qwen3-Reranker-4B
RERANKER_API_KEY=

# ==================== Episode Config ====================
EPISODE_TIME_GAP=1800            # 时间窗口边界(秒), 默认30分钟
EPISODE_MAX_MESSAGES=50          # 消息数量上限, 默认50条
EPISODE_MAX_DURATION=7200        # 最大持续时间(秒), 默认2小时
EPISODE_IDLE_FLUSH=30            # 静默刷新(秒), 用户停止发送后自动关闭episode
EPISODE_SEMANTIC_THRESHOLD=0.50  # 语义转换边界, 低于此值suspend episode
EPISODE_REOPEN_THRESHOLD=0.55    # 语义重连阈值, Max-similarity高于此值reopen
EPISODE_POOL_MAX_SIZE=20         # SuspendPool 最大暂停 episode 数
EPISODE_POOL_ARCHIVE_HOURS=24    # 暂停超过 N 小时自动归档到 Hypergraph
EPISODE_SUSPEND_POOL_PATH=data/suspend_pool.json  # SuspendPool 持久化路径

# ==================== Memory Sleep (Consolidation) Config ====================
MEMORY_SLEEP_ENABLED=true        # 自动睡眠开关
MEMORY_SLEEP_INTERVAL=3600       # 自动睡眠间隔（秒）
MEMORY_SLEEP_DEDUP_THRESHOLD=0.7 # 决策去重 Dice 系数阈值
MEMORY_SLEEP_NOISE_HOT_MIN=5.0   # 噪音修剪最低 hot score
MEMORY_SLEEP_NOISE_CONFIDENCE_MIN=0.3  # 噪音修剪最低置信度
MEMORY_DEDUP_TEMPERATURE=0.05    # LLM 去重判断温度

# ==================== IM Detector Config ====================
LARK_IM_MODE=websocket            # poll | websocket
LARK_IM_DETECTOR_ENABLED=true
LARK_IM_POLL_INTERVAL=10
LARK_IM_BURST_INTERVAL=5
LARK_IM_BURST_TIMEOUT=120

# ==================== Push/Card Config ====================
PUSH_FEISHU_ENABLED=false
PUSH_TERMINAL_ENABLED=true
PUSH_OSASCRIPT_ENABLED=false
PUSH_FEISHU_CHAT_ID=
PUSH_TRIGGER_CREATE=true
PUSH_TRIGGER_CONFLICT=true
PUSH_TRIGGER_UPDATE=true
PUSH_TRIGGER_HOT_SCORE=true
PUSH_HOT_SCORE_THRESHOLD=20.0
PUSH_DAILY_SUMMARY=true
PUSH_DAILY_TIME=08:00
PUSH_WEEKLY_DAY=6
PUSH_WEEKLY_TIME=21:00
PUSH_HOT_SCORE_INCREMENT=10.0
PUSH_HOT_SCORE_DECAY=0.95

# ==================== Doc Detector Config ====================
LARK_DOC_DETECTOR_ENABLED=false
LARK_DOC_POLL_INTERVAL=30
LARK_DOC_BURST_INTERVAL=5
LARK_DOC_BURST_TIMEOUT=120
LARK_DOC_DEBOUNCE_WINDOW=30
DOC_DOCS_DIR=data/docs