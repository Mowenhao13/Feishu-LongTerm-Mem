# ==================== Episode Config ====================
EPISODE_TIME_GAP=1800       # 时间窗口边界(秒), 默认30分钟
EPISODE_MAX_MESSAGES=50    # 消息数量上限, 默认100条
EPISODE_MAX_DURATION=7200   # 最大持续时间(秒), 默认2小时
EPISODE_IDLE_FLUSH=30       # 静默刷新(秒), 用户停止发送后自动关闭episode
EPISODE_SEMANTIC_THRESHOLD=0.5   # 语义转换边界, 低于此值关闭episode
EPISODE_REOPEN_THRESHOLD=0.55    # 语义重连阈值, 高于此值重连到旧episode
EPISODE_POOL_MAX_SIZE=20         # SuspendPool 最大暂停 episode 数
EPISODE_POOL_ARCHIVE_HOURS=24    # 暂停超过 N 小时自动归档到 Hypergraph
EPISODE_SUSPEND_POOL_PATH=data/suspend_pool.json  # SuspendPool 持久化路径

# ==================== Memory Sleep (Consolidation) Config ====================
# 自动睡眠开关 (true=后台自动运行, false=仅手动触发)
MEMORY_SLEEP_ENABLED=true
# 自动睡眠间隔（秒），默认 3600s = 1 小时
MEMORY_SLEEP_INTERVAL=3600
# 决策去重 Dice 系数阈值 (0.0~1.0)，越大越严格
MEMORY_SLEEP_DEDUP_THRESHOLD=0.7
# 噪音修剪最低 hot score，低于此值且低置信度的决策将被标记为 SHELVED
MEMORY_SLEEP_NOISE_HOT_MIN=5.0
# 噪音修剪最低置信度 (0.0~1.0)
MEMORY_SLEEP_NOISE_CONFIDENCE_MIN=0.3
# LLM 去重判断温度 (0.0~1.0)，越小越确定。默认 0.05 = 高度确定
MEMORY_DEDUP_TEMPERATURE=0.05

# ==================== IM Detector Config ====================
LARK_IM_MODE=websocket # poll | websocket
LARK_IM_DETECTOR_ENABLED=true
LARK_IM_POLL_INTERVAL=10
LARK_IM_BURST_INTERVAL=5
LARK_IM_BURST_TIMEOUT=120

